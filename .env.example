# ==========================================
# PkgSentinel Environment Configuration
# ==========================================
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets to source control.

# --- Global / Environment ---
ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL Database ---
POSTGRES_DB=pkgsentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_secret_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis Queue & Cache ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Spring Boot Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Python Security Engine ---
SECURITY_ENGINE_PORT=8000
SECURITY_ENGINE_WORKERS=2
EPHEMERAL_WORKSPACE_DIR=/tmp/pkgsentinel/workspaces

# --- Sandbox Controller ---
SANDBOX_CONTROLLER_PORT=8001
DOCKER_RUNTIME=runc

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080
FRONTEND_PORT=5173

