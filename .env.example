# ====================================================================
# PkgSentinel Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or production credentials to source control.
# ====================================================================

# --- Global / Environment ---
ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL Database ---
POSTGRES_DB=pkgsentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_secret_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis Queue & Cache ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Spring Boot Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Shared Internal Worker Secret (Worker -> Backend Callback Auth) ---
INTERNAL_AUTH_SECRET=sentinel-internal-secure-token-2026

# --- Python Security Engine & Worker ---
SECURITY_ENGINE_PORT=8000
SECURITY_ENGINE_WORKERS=2
SECURITY_ENGINE_EPHEMERAL_WORKSPACE_DIR=/tmp/pkgsentinel/workspaces

# --- Sandbox Controller (Phase 2 Target) ---
SANDBOX_CONTROLLER_PORT=8001
DOCKER_RUNTIME=runc

# --- Frontend ---
# In Docker compose, leave blank to use the Nginx /api/ reverse proxy.
# In local standalone development (npm run dev without Docker), set to http://localhost:8080
VITE_API_BASE_URL=
FRONTEND_PORT=3000
